# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================
# MONOREPO: 3 PROJECTS IN 1 SOURCE CODE
# - /extension (Browser Extension)
# - /webapp (Next.js Web App)
# - /Reveal-project (Third Project)
# ============================================

# dependencies
**/node_modules
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# testing
**/coverage
**/.nyc_output
**/test-results

# next.js (webapp)
webapp/.next/
webapp/out/
webapp/.swc/

# production builds
**/build
**/dist
**/out

# browser extension builds
extension/build/
extension/dist/
extension/*.zip
extension/*.crx
extension/*.pem

# misc
.DS_Store
*.pem
*.log
.vscode/settings.json
.idea/

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# vercel (webapp)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
**/.turbo

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*~

# Cache
.cache
.parcel-cache
.eslintcache

# Optional: Package manager lock files (uncomment if you want to ignore)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
